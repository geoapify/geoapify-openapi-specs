{
  "openapi": "3.1.0",
  "info": {
    "title": "Geoapify Place Info API",
    "version": "2.0.0",
    "description": "Retrieve categorized place information for coordinates or an OpenStreetMap object."
  },
  "servers": [
    {
      "url": "https://api.geoapify.com/v2",
      "description": "Default API endpoint."
    },
    {
      "url": "https://api-eu.geoapify.com/v2",
      "description": "EU-focused endpoint. Geoapify service processing uses EU infrastructure."
    }
  ],
  "tags": [
    {
      "name": "Place Info"
    }
  ],
  "paths": {
    "/place-info": {
      "get": {
        "tags": [
          "Place Info"
        ],
        "operationId": "getPlaceInfo",
        "summary": "Get place information",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "description": "Place latitude. Must be used with lon.",
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": false,
            "description": "Place longitude. Must be used with lat.",
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          {
            "name": "osm_id",
            "in": "query",
            "required": false,
            "description": "OpenStreetMap object identifier.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "osm_type",
            "in": "query",
            "required": false,
            "description": "OpenStreetMap object type.",
            "schema": {
              "type": "string",
              "enum": [
                "r",
                "w",
                "n"
              ]
            }
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "description": "Optional place name.",
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 1024
            }
          },
          {
            "name": "isBuilding",
            "in": "query",
            "required": false,
            "description": "Whether the requested object is a building.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "skipAddress",
            "in": "query",
            "required": false,
            "description": "Skip address enrichment.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "lang",
