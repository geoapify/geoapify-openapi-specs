                  "value": {
                    "operation": "distance",
                    "point1": {
                      "type": "Point",
                      "coordinates": [
                        13.405,
                        52.52
                      ]
                    },
                    "point2": {
                      "type": "Point",
                      "coordinates": [
                        13.39,
                        52.51
