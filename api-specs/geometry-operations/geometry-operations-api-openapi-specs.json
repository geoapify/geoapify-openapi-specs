                            13.44,
                            52.54
                          ]
                        ]
                      ]
                    }
                  }
                },
                "buffer": {
                  "summary": "Create a 500-meter buffer around a point",
                  "value": {
                    "operation": "buffer",
                    "geometry": {
                      "type": "Point",
                      "coordinates": [
                        13.405,
                        52.52
                      ]
                    },
                    "distance": 500,
                    "params": {
                      "units": "meters",
                      "steps": 16
                    }
                  }
                },
                "bbox": {
                  "summary": "Calculate a polygon bounding box",
                  "value": {
                    "operation": "bbox",
                    "geometry": {
                      "type": "Polygon",
                      "coordinates": [
                        [
