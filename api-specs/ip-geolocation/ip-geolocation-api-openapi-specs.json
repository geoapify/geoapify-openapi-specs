        "responses": {
          "200": {
            "description": "IP geolocation result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IpGeolocationResponse"
                },
                "example": {
                  "city": {
                    "name": "New York",
                    "names": {
                      "en": "New York",
                      "de": "New York City",
                      "es": "Nueva York",
                      "fa": "نیویورک",
                      "fr": "New York",
                      "ja": "マンハッタン",
                      "ko": "뉴욕",
