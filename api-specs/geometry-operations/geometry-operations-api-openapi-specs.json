          "required": true,
          "description": "Operation name, named GeoJSON inputs, and optional operation-specific parameters.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GeometryOperationRequest"
              },
              "examples": {
                "intersection": {
                  "summary": "Intersect two overlapping polygons",
                  "value": {
                    "operation": "intersection",
                    "polygons": [
                      {
                        "type": "Polygon",
                        "coordinates": [
                          [
                            [
                              13.38,
                              52.5
                            ],
                            [
                              13.42,
                              52.5
                            ],
                            [
                              13.42,
                              52.54
                            ],
                            [
                              13.38,
                              52.54
                            ],
                            [
                              13.38,
                              52.5
                            ]
                          ]
                        ]
                      },
                      {
                        "type": "Polygon",
                        "coordinates": [
                          [
                            [
                              13.4,
                              52.51
                            ],
                            [
                              13.44,
                              52.51
                            ],
                            [
                              13.44,
                              52.55
                            ],
                            [
                              13.4,
                              52.55
                            ],
                            [
                              13.4,
                              52.51
                            ]
                          ]
                        ]
                      }
                    ]
                  }
                },
                "difference": {
                  "summary": "Subtract one polygon from another",
                  "description": "Every polygon after the first is subtracted from the first polygon.",
                  "value": {
                    "operation": "difference",
                    "polygons": [
                      {
                        "type": "Polygon",
                        "coordinates": [
                          [
                            [
                              13.38,
                              52.5
                            ],
                            [
                              13.42,
                              52.5
                            ],
                            [
                              13.42,
                              52.54
                            ],
                            [
                              13.38,
                              52.54
                            ],
                            [
                              13.38,
                              52.5
                            ]
                          ]
                        ]
                      },
                      {
                        "type": "Polygon",
                        "coordinates": [
                          [
                            [
                              13.4,
                              52.51
                            ],
                            [
                              13.44,
                              52.51
                            ],
                            [
                              13.44,
                              52.55
                            ],
                            [
                              13.4,
                              52.55
                            ],
                            [
                              13.4,
                              52.51
                            ]
                          ]
                        ]
                      }
                    ]
                  }
                },
                "union": {
                  "summary": "Merge two polygons",
                  "value": {
                    "operation": "union",
                    "polygons": [
                      {
                        "type": "Polygon",
                        "coordinates": [
                          [
                            [
                              13.38,
                              52.5
                            ],
                            [
                              13.42,
                              52.5
                            ],
                            [
                              13.42,
                              52.54
                            ],
                            [
                              13.38,
                              52.54
                            ],
                            [
                              13.38,
                              52.5
                            ]
                          ]
                        ]
                      },
                      {
                        "type": "Polygon",
                        "coordinates": [
