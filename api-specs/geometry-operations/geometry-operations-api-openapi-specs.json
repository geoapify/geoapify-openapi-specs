                "pointsWithinPolygon": {
                  "summary": "Select points located inside a polygon",
                  "value": {
                    "operation": "pointsWithinPolygon",
                    "points": [
                      {
                        "type": "Point",
                        "coordinates": [
                          13.405,
                          52.52
                        ]
                      },
