                        "name_native": "English"
                      }
                    ]
                  },
                  "state": {
                    "name": "New York"
                  },
                  "location": {
                    "latitude": 40.7128,
                    "longitude": -74.006
                  },
                  "continent": {
                    "code": "NA",
                    "name": "North America",
                    "names": {
                      "de": "Nordamerika",
                      "en": "North America",
                      "es": "Norteamérica",
                      "fa": "آمریکای شمالی",
                      "fr": "Amérique du Nord",
                      "ja": "北アメリカ",
                      "ko": "북아메리카",
