                "nearestPointOnLine": {
                  "summary": "Find the nearest position on a line",
                  "value": {
                    "operation": "nearestPointOnLine",
                    "point": {
                      "type": "Point",
                      "coordinates": [
                        13.405,
                        52.52
                      ]
                    },
                    "line": {
