                    }
                  }
                },
                "centerOfMass": {
                  "summary": "Calculate a polygon center of mass",
                  "value": {
                    "operation": "centerOfMass",
                    "geometry": {
                      "type": "Polygon",
                      "coordinates": [
                        [
                          [
                            13.38,
                            52.5
                          ],
